# -------------------------------------------------------------
# urtaskhelper — Environment Variables
# Salin file ini menjadi .env.local untuk development lokal
# dan tambahkan juga di Vercel Project Settings → Environment Variables
# -------------------------------------------------------------

# Supabase Project URL & Keys (Dapatkan dari Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (HANYA di backend/server, untuk membuat signed URL download private file)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nomor WhatsApp Admin untuk tombol "Hubungi Admin via WhatsApp" (format 628xxx atau 08xxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

