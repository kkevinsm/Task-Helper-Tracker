# -------------------------------------------------------------
# urtaskhelper — Environment Variables
# Salin file ini menjadi .env.local untuk development lokal
# dan tambahkan juga di Vercel Project Settings → Environment Variables
# -------------------------------------------------------------

# Supabase Project URL & Keys (Dapatkan dari Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (HANYA di backend/server, untuk membuat signed URL download private file)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nomor WhatsApp Admin untuk tombol "Hubungi Admin via WhatsApp" (format 628xxx atau 08xxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Telegram Bot (opsional, untuk input pesanan via chat bot Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Telegram User ID admin (pisahkan koma jika lebih dari 1). Cek via /id di bot.
TELEGRAM_ADMIN_IDS=123456789
# Secret acak untuk verifikasi webhook Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-string-acak-panjang
# URL publik aplikasi (untuk link tracking di balasan bot, opsional di Vercel)
NEXT_PUBLIC_APP_URL=https://urtaskhelper.vercel.app

